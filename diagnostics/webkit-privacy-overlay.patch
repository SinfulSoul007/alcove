+- (BOOL)_setExtensionPrivacyPreferences:(NSDictionary<NSString *, id> *)overrides
+{
+    if (![overrides isKindOfClass:NSDictionary.class])
+        return NO;
+
+    // Validate the complete update before changing any existing override.
+    for (id key in overrides) {
+        if (![key isKindOfClass:NSString.class])
+            return NO;
+
+        id value = overrides[key];
+        if ([key isEqualToString:@"networkPredictionEnabled"] || [key isEqualToString:@"hyperlinkAuditingEnabled"]) {
+            if (![value isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)value) != CFBooleanGetTypeID())
+                return NO;
+        } else if ([key isEqualToString:@"webRTCIPHandlingPolicy"]) {
+            if (![value isKindOfClass:NSString.class] || (![(NSString *)value isEqualToString:@"default"]
+                && ![(NSString *)value isEqualToString:@"default_public_and_private_interfaces"]
+                && ![(NSString *)value isEqualToString:@"default_public_interface_only"]
+                && ![(NSString *)value isEqualToString:@"disable_non_proxied_udp"]))
+                return NO;
+        } else
+            return NO;
+    }
+
+    NSNumber *prediction = overrides[@"networkPredictionEnabled"];
+    NSNumber *auditing = overrides[@"hyperlinkAuditingEnabled"];
+    NSString *policy = overrides[@"webRTCIPHandlingPolicy"];
+    _page->setExtensionPrivacyPreferences(prediction ? std::optional<bool>(prediction.boolValue) : std::nullopt,
+        auditing ? std::optional<bool>(auditing.boolValue) : std::nullopt, policy ? String(policy) : nullString());
+    return YES;
+}
+
 - (BOOL)_networkRequestsInProgress
 {
     return _page->pageLoadState().networkRequestsInProgress();
 }

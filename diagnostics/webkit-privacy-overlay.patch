 const WebPreferencesStore& WebPageProxy::preferencesStore() const
 {
+    if (m_extensionPrivacyPreferencesStore)
+        return *m_extensionPrivacyPreferencesStore;
     return m_preferences->store();
 }

+void WebPageProxy::setExtensionPrivacyPreferences(std::optional<bool> networkPrediction, std::optional<bool> hyperlinkAuditing, String webRTCIPHandlingPolicy)
+{
+    if (m_extensionNetworkPrediction == networkPrediction && m_extensionHyperlinkAuditing == hyperlinkAuditing && m_extensionWebRTCIPHandlingPolicy == webRTCIPHandlingPolicy)
+        return;
+
+    m_extensionNetworkPrediction = networkPrediction;
+    m_extensionHyperlinkAuditing = hyperlinkAuditing;
+    m_extensionWebRTCIPHandlingPolicy = WTF::move(webRTCIPHandlingPolicy);
+    preferencesDidChange();
+}
+
+void WebPageProxy::updateExtensionPrivacyPreferencesStore()
+{
+    if (!m_extensionNetworkPrediction && !m_extensionHyperlinkAuditing && m_extensionWebRTCIPHandlingPolicy.isNull()) {
+        m_extensionPrivacyPreferencesStore = nullptr;
+        return;
+    }
+
+    // Overlay the latest embedder values without changing a shared WebPreferences object.
+    if (!m_extensionPrivacyPreferencesStore)
+        m_extensionPrivacyPreferencesStore = makeUnique<WebPreferencesStore>(m_preferences->store());
+    else
+        *m_extensionPrivacyPreferencesStore = m_preferences->store();
+
+    if (m_extensionNetworkPrediction)
+        m_extensionPrivacyPreferencesStore->setBoolValueForKey(WebPreferencesKey::networkPredictionEnabledKey(), *m_extensionNetworkPrediction);
+    if (m_extensionHyperlinkAuditing)
+        m_extensionPrivacyPreferencesStore->setBoolValueForKey(WebPreferencesKey::hyperlinkAuditingEnabledKey(), *m_extensionHyperlinkAuditing);
+    if (!m_extensionWebRTCIPHandlingPolicy.isNull())
+        m_extensionPrivacyPreferencesStore->setStringValueForKey(WebPreferencesKey::webRTCIPHandlingPolicyKey(), m_extensionWebRTCIPHandlingPolicy);
+}

+bool WebExtensionContext::hasPrivacyPermissionAt(WallTime time) const
+{
+    // Constructor-time policy reads must not prune unrelated permissions or
+    // notify views that are still being initialized. Match explicit denial
+    // precedence and expiry semantics without mutating either permission map.
+    auto permission = WebExtensionPermission::privacy();
+    auto denied = m_deniedPermissions.find(permission);
+    if (denied != m_deniedPermissions.end() && !(denied->value <= time))
+        return false;
+    auto granted = m_grantedPermissions.find(permission);
+    return granted != m_grantedPermissions.end() && !(granted->value <= time);
+}

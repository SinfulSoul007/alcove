+bool WebExtensionMatchPattern::isValidOpaqueMenuTargetPattern(const String& pattern)
+{
+    auto separator = pattern.find(':');
+    if (!separator || separator == notFound || separator + 1 == pattern.length() || pattern.contains("://"_s))
+        return false;
+
+    auto scheme = URLParser::maybeCanonicalizeScheme(pattern.left(separator));
+    return scheme && !URLParser::isSpecialScheme(scheme.value()) && !extensionSchemes().contains(scheme.value());
+}
+
+bool WebExtensionMatchPattern::opaqueMenuTargetPatternMatchesURL(const String& pattern, const URL& url)
+{
+    if (!url.isValid() || !isValidOpaqueMenuTargetPattern(pattern))
+        return false;
+
+    auto separator = pattern.find(':');
+    auto scheme = URLParser::maybeCanonicalizeScheme(pattern.left(separator));
+    if (!url.protocolIs(scheme.value()))
+        return false;
+
+    // Include the query, keep '?' literal, and omit the fragment.
+    auto target = url.stringWithoutFragmentIdentifier();
+    return matchesWildcardPattern(pattern.substring(separator + 1), target.substring(url.protocol().length() + 1));
+}
+
 bool WebExtensionMatchPattern::matchesURL(const URL& urlToMatch, OptionSet<Options> options) const
 {
     ASSERT(!options.contains(Options::MatchBidirectionally));

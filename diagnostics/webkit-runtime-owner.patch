-NSURL *WebExtensionAPIRuntime::getURL(const String& resourcePath, NSString **outExceptionString)
+JSValueRef JSWebExtensionAPIRuntime::getURL(JSContextRef context, JSObjectRef object, JSStringRef propertyName, JSValueRef*)
 {
-    // Documentation: https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/runtime/getURL
+    RefPtr runtime = toWebExtensionAPIRuntime(context, object);
+    if (!runtime) [[unlikely]]
+        return JSValueMakeUndefined(context);
 
-    return URL { extensionContext().baseURL(), resourcePath }.createNSURL().autorelease();
+    if (auto cached = JSObjectGetPrivateProperty(context, object, propertyName))
+        return cached;
+
+    // The callable belongs to this extension even when JavaScript stores it on another object.
+    URL baseURL = runtime->extensionContext().baseURL();
+    JSContext *scriptContext = [JSContext contextWithJSGlobalContextRef:JSContextGetGlobalContext(context)];
+    JSValue *function = [JSValue valueWithObject:^JSValue * {
+        JSContext *callContext = JSContext.currentContext;
+        JSValue *path = JSContext.currentArguments.firstObject;
+        if (!path.isString) {
+            auto argument = path ? "resourcePath"_s : nullString();
+            auto message = path ? "a string is expected"_s : "a required argument is missing"_s;
+            auto error = toJSError(callContext.JSGlobalContextRef, "runtime.getURL()"_s, argument, message);
+            callContext.exception = [JSValue valueWithJSValueRef:error inContext:callContext];
+            return [JSValue valueWithUndefinedInContext:callContext];
+        }
+
+        NSURL *resource = URL { baseURL, String(path.toString) }.createNSURL().autorelease();
+        if (!resource)
+            return [JSValue valueWithNullInContext:callContext];
+        return [JSValue valueWithObject:resource.absoluteString inContext:callContext];
+    } inContext:scriptContext];
+    auto result = function.JSValueRef;
+    JSObjectSetPrivateProperty(context, object, propertyName, result);
+    return result;
 }
 

+void WebExtensionContext::resourceLoadShouldCancel(WebPageProxyIdentifier pageID, const ResourceLoadInfo& loadInfo, CompletionHandler<void(bool)>&& completionHandler)
+{
+    RefPtr tab = getTab(pageID);
+    if (!isLoaded() || extension().manifestVersion() != 2 || !hasPermission(WebExtensionPermission::webRequestBlocking(), tab.get())
+        || !hasPermissionToSendWebRequestEvent(tab.get(), loadInfo.originalURL, loadInfo))
+        return completionHandler(false);
+
+    constexpr auto listenerType = WebExtensionEventListenerType::WebRequestOnBeforeRequest;
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ listenerType }, [this, protectedThis = Ref { *this }, pageID, loadInfo, completionHandler = WTF::move(completionHandler)]() mutable {
+        RefPtr tab = getTab(pageID);
+        if (!isLoaded() || !hasPermission(WebExtensionPermission::webRequestBlocking(), tab.get())
+            || !hasPermissionToSendWebRequestEvent(tab.get(), loadInfo.originalURL, loadInfo))
+            return completionHandler(false);
+
+        RefPtr window = tab->window();
+        auto windowIdentifier = window ? window->identifier() : WebExtensionWindowConstants::NoneIdentifier;
+        Ref replies = EagerCallbackAggregator<void(bool)>::create(WTF::move(completionHandler), false);
+        for (auto& process : processes(listenerType, WebExtensionContentWorldType::Main)) {
+            process->sendWithAsyncReply(Messages::WebExtensionContextProxy::ResourceLoadShouldCancel(tab->identifier(), windowIdentifier, loadInfo), [weakThis = WeakPtr { *this }, replies, pageID, loadInfo](bool shouldCancel) {
+                RefPtr context = weakThis.get();
+                if (!shouldCancel || !context || !context->isLoaded())
+                    return;
+                RefPtr tab = context->getTab(pageID);
+                if (context->hasPermission(WebExtensionPermission::webRequestBlocking(), tab.get())
+                    && context->hasPermissionToSendWebRequestEvent(tab.get(), loadInfo.originalURL, loadInfo))
+                    replies.get()(true);
+            }, identifier());
+        }
+    });
+}

+void WebExtensionContextProxy::resourceLoadShouldCancel(WebExtensionTabIdentifier tabID, WebExtensionWindowIdentifier windowID, const ResourceLoadInfo& resourceLoad, CompletionHandler<void(bool)>&& completionHandler)
+{
+    auto *details = webRequestDetailsForResourceLoad(resourceLoad, tabID);
+    bool shouldCancel = false;
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        namespaceObject.webRequest().onBeforeRequest().enumerateListeners(tabID, windowID, resourceLoad, [&](auto& listener, auto& extraInfo) {
+            if (!extraInfo.contains("blocking"_s))
+                return;
+
+            auto context = listener.globalContext();
+            auto result = listener.call(toJSValueRef(context, details));
+            if (!result || !JSValueIsObject(context, result))
+                return;
+            JSValue *value = toJSValue(context, result);
+            JSValue *cancel = value[@"cancel"];
+            if (cancel.isBoolean && cancel.toBool)
+                shouldCancel = true;
+        });
+    });
+    completionHandler(shouldCancel);
+}

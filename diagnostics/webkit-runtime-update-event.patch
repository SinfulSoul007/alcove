+void WebExtensionContext::didFindExtensionUpdate(const String& version)
+{
+    RefPtr extensionController = this->extensionController();
+    if (!extensionController || version.isEmpty() || version == protectedExtension()->version())
+        return;
+
+    // The embedder verifies and approves the pending package before announcing it.
+    constexpr auto type = WebExtensionEventListenerType::RuntimeOnUpdateAvailable;
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ type }, [=, this, protectedThis = Ref { *this }] {
+        if (this->extensionController() != extensionController.get() || version == protectedExtension()->version())
+            return;
+
+        sendToProcessesForEvent(type, Messages::WebExtensionContextProxy::DispatchRuntimeUpdateAvailableEvent(version));
+    });
+}

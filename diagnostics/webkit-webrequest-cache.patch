+
+void WebExtensionContext::webRequestHandlerBehaviorChanged(CompletionHandler<void(Expected<void, WebExtensionError>&&)>&& completionHandler)
+{
+    RefPtr controller = protectedExtensionController();
+    if (!controller)
+        return completionHandler(toWebExtensionError(@"webRequest.handlerBehaviorChanged()", nullString(), @"the extension is no longer loaded"));
+
+    auto now = MonotonicTime::now();
+    auto cutoff = now - 600_s;
+    while (!m_webRequestCacheChanges.isEmpty() && m_webRequestCacheChanges.first() <= cutoff)
+        m_webRequestCacheChanges.removeFirst();
+    if (m_webRequestCacheChanges.size() >= webExtensionMaximumHandlerBehaviorChanges)
+        return completionHandler(toWebExtensionError(@"webRequest.handlerBehaviorChanged()", nullString(), @"too many cache invalidations in ten minutes"));
+    m_webRequestCacheChanges.append(now);
+
+    Ref callbackAggregator = MainRunLoopCallbackAggregator::create([completionHandler = WTF::move(completionHandler)]() mutable {
+        completionHandler({ });
+    });
+
+    // A rule change only needs renderer resources evicted. Website data removal would
+    // also discard back/forward pages and cached renderer processes.
+    auto invalidateStore = [&](WebsiteDataStore& store) {
+        if (!store.isPersistent() && !hasAccessToPrivateData())
+            return;
+        for (Ref process : store.processes()) {
+            if (process->websiteDataStore() == &store && process->state() == WebProcessProxy::State::Running)
+                process->sendWithAsyncReply(Messages::WebProcess::ClearExtensionResourceMemoryCache(), [callbackAggregator] { });
+        }
+    };
+
+    RefPtr defaultStore = controller->websiteDataStore();
+    if (defaultStore)
+        invalidateStore(*defaultStore);
+    for (Ref store : controller->allWebsiteDataStores()) {
+        if (store.ptr() != defaultStore.get())
+            invalidateStore(store);
+    }
+}

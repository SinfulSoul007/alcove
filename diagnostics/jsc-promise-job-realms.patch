 void JSGlobalObject::queueMicrotask(InternalMicrotask job, uint8_t payload, JSValue argument0, JSValue argument1, JSValue argument2)
 {
-    QueuedTask task { nullptr, job, payload, this, argument0, argument1, argument2 };
-    globalObjectMethodTable()->queueMicrotaskToEventLoop(*this, WTF::move(task));
+    auto* jobGlobalObject = this;
+    JSValue handler = jsUndefined();
+    switch (job) {
+    case InternalMicrotask::PromiseReactionJob:
+        handler = argument1;
+        break;
+    case InternalMicrotask::PromiseFinallyReactionJob:
+        // This slot retains the realm of the optimized finally wrappers until
+        // their reaction runs; the job later reuses it for fulfillment state.
+        jobGlobalObject = jsCast<JSGlobalObject*>(jsCast<JSPromiseCombinatorsGlobalContext*>(argument2)->remainingElementsCount());
+        break;
+    case InternalMicrotask::AsyncFunctionResume:
+        jobGlobalObject = jsCast<JSGenerator*>(argument2)->globalObject();
+        break;
+    default:
+        break;
+    }
+
+    // Promise reaction jobs run with their handler's realm as entry settings,
+    // even when a promise in another realm settles them.
+    if (handler.isCallable()) {
+        auto& vm = this->vm();
+        auto catchScope = DECLARE_CATCH_SCOPE(vm);
+        if (auto* handlerGlobalObject = getFunctionRealm(this, asObject(handler))) {
+            // Private identity/thrower stand-ins represent absent author code.
+            // Keep the settling realm so a closed registration page cannot
+            // discard a live promise's value or rejection propagation.
+            if (handler != handlerGlobalObject->promiseEmptyOnFulfilledFunction()
+                && handler != handlerGlobalObject->promiseEmptyOnRejectedFunction())
+                jobGlobalObject = handlerGlobalObject;
+        } else if (!catchScope.clearExceptionExceptTermination())
+            return;
+        // A revoked proxy uses the current realm; invoking it still rejects.
+    }
+
+    QueuedTask task { nullptr, job, payload, jobGlobalObject, argument0, argument1, argument2 };
+    jobGlobalObject->globalObjectMethodTable()->queueMicrotaskToEventLoop(*jobGlobalObject, WTF::move(task));
 }
 

+static bool isKnownPrivacyKey(NSString *key)
+{
+    return [key isEqualToString:@"networkPredictionEnabled"] || [key isEqualToString:@"hyperlinkAuditingEnabled"] || [key isEqualToString:@"webRTCIPHandlingPolicy"];
+}
+
+static bool isValidStoredPrivacyValue(NSString *key, NSString *value)
+{
+    if (!value)
+        return false;
+    if ([key isEqualToString:@"webRTCIPHandlingPolicy"])
+        return [value isEqualToString:@"default"] || [value isEqualToString:@"default_public_and_private_interfaces"]
+            || [value isEqualToString:@"default_public_interface_only"] || [value isEqualToString:@"disable_non_proxied_udp"];
+    return [value isEqualToString:@"true"] || [value isEqualToString:@"false"];
+}
+
+String WebExtensionContext::privacyValue(NSString *key, bool incognito) const
+{
+    if (incognito && !hasAccessToPrivateData())
+        return nullString();
+    NSDictionary *all = objectForKey<NSDictionary>(m_state, @"AlcovePrivacySettings");
+    auto valueForScope = [&](NSString *scope) -> NSString * {
+        NSDictionary *values = [scope isEqualToString:@"incognito_session_only"] ? m_privateSessionPrivacySettings.get() : objectForKey<NSDictionary>(all, scope);
+        NSString *value = objectForKey<NSString>(values, key);
+        return isValidStoredPrivacyValue(key, value) ? value : nil;
+    };
+    if (incognito) {
+        if (auto *value = valueForScope(@"incognito_session_only"))
+            return String(value);
+        if (auto *value = valueForScope(@"incognito_persistent"))
+            return String(value);
+    } else if (auto *value = valueForScope(@"regular_only"))
+        return String(value);
+    if (auto *value = valueForScope(@"regular"))
+        return String(value);
+    return nullString();
+}
+
+bool WebExtensionContext::privacyValueIsIncognitoSpecific(NSString *key) const
+{
+    NSDictionary *all = objectForKey<NSDictionary>(m_state, @"AlcovePrivacySettings");
+    return isValidStoredPrivacyValue(key, objectForKey<NSString>(m_privateSessionPrivacySettings, key))
+        || isValidStoredPrivacyValue(key, objectForKey<NSString>(objectForKey<NSDictionary>(all, @"incognito_persistent"), key));
+}

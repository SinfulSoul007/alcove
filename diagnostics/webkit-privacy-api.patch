 namespace WebKit {

+static bool hasPrivacyPrecedence(WebExtensionContext& left, WebExtensionContext& right)
+{
+    if (left.privacyInstallationTime() != right.privacyInstallationTime())
+        return left.privacyInstallationTime() > right.privacyInstallationTime();
+    return [left.uniqueIdentifier().createNSString().get() compare:right.uniqueIdentifier().createNSString().get() options:NSLiteralSearch] == NSOrderedDescending;
+}
+
+bool WebExtensionController::hasPrivatePrivacyWindows() const
+{
+    for (Ref context : m_extensionContexts) {
+        for (Ref window : context->openWindows(WebExtensionContext::IgnoreExtensionAccess::Yes)) {
+            if (window->isPrivate())
+                return true;
+        }
+    }
+    return false;
+}
+
+WebExtensionContext* WebExtensionController::privacySettingController(NSString *key, bool incognito)
+{
+    WebExtensionContext *winner = nullptr;
+    for (Ref context : m_extensionContexts) {
+        if (!context->isLoaded() || !context->hasPermission(WebExtensionPermission::privacy()) || (incognito && !context->hasAccessToPrivateData()) || context->privacyValue(key, incognito).isNull())
+            continue;
+        if (!winner || hasPrivacyPrecedence(context.get(), *winner))
+            winner = context.ptr();
+    }
+    return winner;
+}
+
+NSDictionary *WebExtensionController::privacySettingDetails(WebExtensionContext& requester, NSString *key, bool incognito)
+{
+    auto *winner = privacySettingController(key, incognito);
+    id value;
+    if (winner) {
+        String stored = winner->privacyValue(key, incognito);
+        if ([key isEqualToString:@"webRTCIPHandlingPolicy"])
+            value = stored.createNSString().get();
+        else
+            value = @(stored == "true"_s);
+    } else {
+        WKPreferences *preferences = protectedConfiguration()->webViewConfiguration().preferences;
+        if ([key isEqualToString:@"webRTCIPHandlingPolicy"])
+            value = preferences._webRTCIPHandlingPolicy;
+        else if ([key isEqualToString:@"networkPredictionEnabled"])
+            value = @(preferences._networkPredictionEnabled);
+        else
+            value = @(preferences._hyperlinkAuditingEnabled);
+    }
+    NSString *level = winner == &requester ? @"controlled_by_this_extension"
+        : (!winner || hasPrivacyPrecedence(requester, *winner)) ? @"controllable_by_this_extension" : @"controlled_by_other_extensions";
+    NSMutableDictionary *result = [@{ @"value": value, @"levelOfControl": level } mutableCopy];
+    if (requester.hasAccessToPrivateData())
+        result[@"incognitoSpecific"] = @(incognito && winner && winner->privacyValueIsIncognitoSpecific(key));
+    return result;
+}
+
+static String privacyBaselineSignature(WKPreferences *preferences)
+{
+    return String([NSString stringWithFormat:@"%d|%d|%@", preferences._networkPredictionEnabled, preferences._hyperlinkAuditingEnabled, preferences._webRTCIPHandlingPolicy]);
+}
+
+void WebExtensionController::browserPrivacyPreferencesDidChange()
+{
+    auto signature = privacyBaselineSignature(protectedConfiguration()->webViewConfiguration().preferences);
+    if (signature == m_browserPrivacySignature)
+        return;
+    m_browserPrivacySignature = WTF::move(signature);
+    updatePrivacySettings();
+}
+
+void WebExtensionController::updatePrivacySettings()
+{
+    if (m_updatingPrivacySettings) {
+        m_privacySettingsNeedUpdate = true;
+        return;
+    }
+    do {
+        m_privacySettingsNeedUpdate = false;
+        m_updatingPrivacySettings = true;
+        m_browserPrivacySignature = privacyBaselineSignature(protectedConfiguration()->webViewConfiguration().preferences);
+        if (!hasPrivatePrivacyWindows()) {
+            for (Ref context : m_extensionContexts)
+                context->clearPrivateSessionPrivacySettings();
+        }
+        for (Ref page : m_pages) {
+            bool incognito = !page->websiteDataStore().isPersistent();
+            std::optional<bool> prediction;
+            std::optional<bool> auditing;
+            String rtcPolicy;
+            if (auto *winner = privacySettingController(@"networkPredictionEnabled", incognito))
+                prediction = winner->privacyValue(@"networkPredictionEnabled", incognito) == "true"_s;
+            if (auto *winner = privacySettingController(@"hyperlinkAuditingEnabled", incognito))
+                auditing = winner->privacyValue(@"hyperlinkAuditingEnabled", incognito) == "true"_s;
+            if (auto *winner = privacySettingController(@"webRTCIPHandlingPolicy", incognito))
+                rtcPolicy = winner->privacyValue(@"webRTCIPHandlingPolicy", incognito);
+            page->setExtensionPrivacyPreferences(prediction, auditing, WTF::move(rtcPolicy));
+        }
+        for (Ref context : m_extensionContexts) {
+            for (NSString *key in @[ @"networkPredictionEnabled", @"hyperlinkAuditingEnabled", @"webRTCIPHandlingPolicy" ]) {
+                context->firePrivacySettingChangedIfNeeded(key, false);
+                context->firePrivacySettingChangedIfNeeded(key, true);
+            }
+        }
+
+        WallTime nextExpiration = WallTime::infinity();
+        auto now = WallTime::now();
+        for (Ref context : m_extensionContexts) {
+            if (!context->hasPermission(WebExtensionPermission::privacy()))
+                continue;

+
+JSValueRef JSWebExtensionAPINamespace::privacy(JSContextRef context, JSObjectRef object, JSStringRef propertyName, JSValueRef*)
+{
+    RefPtr impl = toWebExtensionAPINamespace(context, object);
+    if (!impl)
+        return JSValueMakeUndefined(context);
+    if (auto cached = JSObjectGetPrivateProperty(context, object, propertyName))
+        return cached;
+
+    JSContext *scriptContext = toJSContext(context);
+    JSValue *privacy = [JSValue valueWithNewObjectInContext:scriptContext];
+    JSValue *network = [JSValue valueWithNewObjectInContext:scriptContext];
+    JSValue *websites = [JSValue valueWithNewObjectInContext:scriptContext];
+    privacy[@"network"] = network;
+    privacy[@"websites"] = websites;
+    for (NSString *key in @[ @"networkPredictionEnabled", @"webRTCIPHandlingPolicy", @"hyperlinkAuditingEnabled" ]) {
+        JSValue *setting = [JSValue valueWithNewObjectInContext:scriptContext];
+        for (NSString *operation in @[ @"get", @"set", @"clear" ]) {
+            RefPtr<WebExtensionContextProxy> owner = impl->protectedExtensionContext();
+            RefPtr<WebExtensionAPIRuntime> runtime = impl->protectedRuntime();
+            String ownedKey(key);
+            String ownedOperation(operation);
+            setting[operation] = [JSValue valueWithObject:^JSValue * {
+                JSContext *callContext = JSContext.currentContext;
+                JSGlobalContextRef globalContext = callContext.JSGlobalContextRef;
+                NSArray<JSValue *> *arguments = JSContext.currentArguments;
+                JSValue *details = arguments.firstObject;
+                JSValue *function = arguments.count > 1 ? arguments[1] : nil;
+                if (arguments.count > 2 || !details || !isDictionary(globalContext, details.JSValueRef)
+                    || (function && !function.isUndefined && !isFunction(globalContext, function.JSValueRef))) {
+                    callContext.exception = toJSValue(globalContext, toJSError(globalContext, "privacy"_s, nullString(), "an options object and optional callback are expected"_s));
+                    return [JSValue valueWithUndefinedInContext:callContext];
+                }
+                JSValueRef exception = nullptr;
+                String json = serializeJSObject(globalContext, details.JSValueRef, &exception);
+                if (exception) {
+                    callContext.exception = toJSValue(globalContext, exception);
+                    return [JSValue valueWithUndefinedInContext:callContext];
+                }
+                RefPtr callback = toJSCallbackHandler(globalContext, function ? function.JSValueRef : JSValueMakeUndefined(globalContext), *runtime);
+                JSObjectRef promise = nullptr;
+                if (!callback) {
+                    JSObjectRef resolve = nullptr;
+                    JSObjectRef reject = nullptr;
+                    promise = JSObjectMakeDeferredPromise(globalContext, &resolve, &reject, &exception);
+                    if (exception || !promise) {
+                        if (exception)
+                            callContext.exception = toJSValue(globalContext, exception);
+                        return [JSValue valueWithUndefinedInContext:callContext];
+                    }
+                    callback = toJSPromiseCallbackHandler(globalContext, resolve, reject);
+                }
+                performPrivacySettingOperation(*owner, ownedKey, ownedOperation, json, callback.releaseNonNull());
+                return promise ? toJSValue(globalContext, promise) : [JSValue valueWithUndefinedInContext:callContext];
+            } inContext:scriptContext];
+        }
+        setting[@"onChange"] = toJSValue(context, toJS(context, &impl->privacyOnChange(String(key))));
+        if ([key isEqualToString:@"hyperlinkAuditingEnabled"])
+            websites[key] = setting;
+        else
+            network[key] = setting;
+    }
+    JSObjectSetPrivateProperty(context, object, propertyName, privacy.JSValueRef);
+    return privacy.JSValueRef;
+}
+
+static void performPrivacySettingOperation(WebExtensionContextProxy& context, const String& key, const String& operation, const String& detailsJSON, Ref<WebExtensionCallbackHandler>&& callback)
+{
+    WebProcess::singleton().sendWithAsyncReply(Messages::WebExtensionContext::PrivacySettingOperation(key, operation, detailsJSON),
+        [callback = WTF::move(callback), returnsValue = operation == "get"_s](Expected<String, WebExtensionError>&& result) {
+            if (!result) {
+                callback->reportError(result.error().createNSString().get());
+                return;
+            }
+            if (returnsValue)
+                callback->call(deserializeJSONString(callback->globalContext(), result.value()));
+            else
+                callback->call();
+        }, context.identifier());
+}
+
+WebExtensionAPIEvent& WebExtensionAPINamespace::privacyOnChange(const String& key)
+{
+    auto& event = key == "networkPredictionEnabled"_s ? m_privacyPredictionChange : key == "hyperlinkAuditingEnabled"_s ? m_privacyAuditingChange : m_privacyRTCChange;
+    auto type = key == "networkPredictionEnabled"_s ? WebExtensionEventListenerType::PrivacyPredictionOnChange
+        : key == "hyperlinkAuditingEnabled"_s ? WebExtensionEventListenerType::PrivacyAuditingOnChange : WebExtensionEventListenerType::PrivacyRTCOnChange;
+    if (!event) {
+        event = WebExtensionAPIEvent::create(*this, type);
+        event->setPropertyPath(makeString("privacy."_s, key == "hyperlinkAuditingEnabled"_s ? "websites."_s : "network."_s, key, ".onChange"_s), this);
+    }
+    return *event;
+}
+
+void WebExtensionContextProxy::dispatchPrivacySettingChangedEvent(const String& key, const String& detailsJSON)
+{
+    NSDictionary *details = dynamic_objc_cast<NSDictionary>(parseJSON(detailsJSON.createNSString().get()));
+    if (!details)
+        return;
+    enumerateNamespaceObjects([&](auto& namespaceObject) {
+        namespaceObject.privacyOnChange(key).invokeListenersWithArgument(details);
+    });
+}

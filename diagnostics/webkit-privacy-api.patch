+void WebExtensionContext::privacySettingOperation(const String& rawKey, const String& operation, const String& detailsJSON, CompletionHandler<void(Expected<String, WebExtensionError>&&)>&& completionHandler)
+{
+    auto fail = [&](NSString *message) {
+        completionHandler(toWebExtensionError("privacy"_s, nullString(), String(message)));
+    };
+    if (!isLoaded() || !hasPermission(WebExtensionPermission::privacy())) {
+        fail(@"the privacy permission is not granted");
+        return;
+    }
+    NSString *key = rawKey.createNSString().get();
+    NSDictionary *details = dynamic_objc_cast<NSDictionary>(parseJSON(detailsJSON.createNSString().get()));
+    if (!isKnownPrivacyKey(key) || !details || (operation != "get"_s && operation != "set"_s && operation != "clear"_s)) {
+        fail(@"invalid setting or operation");
+        return;
+    }
+    for (id field in details) {
+        if (![field isKindOfClass:NSString.class] || (operation == "get"_s ? ![field isEqualToString:@"incognito"]
+            : (![field isEqualToString:@"scope"] && !(operation == "set"_s && [field isEqualToString:@"value"])))) {
+            fail(@"unknown setting details");
+            return;
+        }
+    }
+    RefPtr controller = extensionController();
+    if (!controller) {
+        fail(@"the extension is not loaded");
+        return;
+    }
+    if (operation == "get"_s) {
+        id flag = details[@"incognito"];
+        if (flag && (![flag isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)flag) != CFBooleanGetTypeID())) {
+            fail(@"incognito must be a boolean");
+            return;
+        }
+        bool incognito = [flag boolValue];
+        if (incognito && !hasAccessToPrivateData()) {
+            fail(@"private browsing access is not granted");
+            return;
+        }
+        completionHandler(String(encodeJSONString(controller->privacySettingDetails(*this, key, incognito))));
+        return;
+    }
+    NSString *scope = details[@"scope"] ? objectForKey<NSString>(details, @"scope") : @"regular";
+    if (!scope || (![@"regular" isEqualToString:scope] && ![@"regular_only" isEqualToString:scope]
+        && ![@"incognito_persistent" isEqualToString:scope] && ![@"incognito_session_only" isEqualToString:scope])) {
+        fail(@"invalid scope");
+        return;
+    }
+    bool privateScope = [scope hasPrefix:@"incognito_"];
+    bool sessionScope = [scope isEqualToString:@"incognito_session_only"];
+    if (privateScope && operation == "set"_s && !hasAccessToPrivateData()) {
+        fail(@"private browsing access is not granted");
+        return;
+    }
+    if (sessionScope && operation == "set"_s && !controller->hasPrivatePrivacyWindows()) {
+        fail(@"an open private window is required for session-only settings");
+        return;
+    }
+    NSString *value = nil;
+    if (operation == "set"_s) {
+        id input = details[@"value"];
+        if ([key isEqualToString:@"webRTCIPHandlingPolicy"])
+            value = dynamic_objc_cast<NSString>(input);
+        else if ([input isKindOfClass:NSNumber.class] && CFGetTypeID((__bridge CFTypeRef)input) == CFBooleanGetTypeID())
+            value = [input boolValue] ? @"true" : @"false";
+        if (!isValidStoredPrivacyValue(key, value)) {
+            fail(@"invalid value for this setting");
+            return;
+        }
+    }
+    if (sessionScope) {
+        if (!m_privateSessionPrivacySettings)
+            m_privateSessionPrivacySettings = [NSMutableDictionary dictionary];
+        if (value)
+            m_privateSessionPrivacySettings.get()[key] = value;
+        else
+            [m_privateSessionPrivacySettings removeObjectForKey:key];
+    } else {
+        NSMutableDictionary *all = [objectForKey<NSDictionary>(m_state, @"AlcovePrivacySettings") mutableCopy] ?: [NSMutableDictionary dictionary];
+        NSMutableDictionary *values = [objectForKey<NSDictionary>(all, scope) mutableCopy] ?: [NSMutableDictionary dictionary];
+        if (value)
+            values[key] = value;
+        else
+            [values removeObjectForKey:key];
+        all[scope] = values;
+        m_state.get()[@"AlcovePrivacySettings"] = all;
+        writeStateToStorage();
+    }
+    controller->updatePrivacySettings();
+    completionHandler("null"_s);
+}
+
+void WebExtensionContext::firePrivacySettingChangedIfNeeded(NSString *key, bool incognito)
+{
+    RefPtr controller = extensionController();
+    if (!controller || !hasPermission(WebExtensionPermission::privacy()) || (incognito && !hasAccessToPrivateData()))
+        return;
+    NSDictionary *details = controller->privacySettingDetails(*this, key, incognito);
+    NSString *cacheKey = [key stringByAppendingString:incognito ? @":private" : @":regular"];
+    NSString *signature = [NSString stringWithFormat:@"%@|%@|%@", details[@"value"], details[@"levelOfControl"], details[@"incognitoSpecific"] ?: @"omitted"];
+    if (!m_privacyEventSignatures)
+        m_privacyEventSignatures = [NSMutableDictionary dictionary];
+    NSString *previous = objectForKey<NSString>(m_privacyEventSignatures, cacheKey);
+    m_privacyEventSignatures.get()[cacheKey] = signature;
+    if (!previous || [previous isEqualToString:signature])
+        return;
+    auto type = [key isEqualToString:@"networkPredictionEnabled"] ? WebExtensionEventListenerType::PrivacyPredictionOnChange
+        : [key isEqualToString:@"hyperlinkAuditingEnabled"] ? WebExtensionEventListenerType::PrivacyAuditingOnChange : WebExtensionEventListenerType::PrivacyRTCOnChange;
+    String payload(encodeJSONString(details));
+    wakeUpBackgroundContentIfNecessaryToFireEvents({ type }, [=, this, protectedThis = Ref { *this }] {
+        if (!isLoaded() || !hasPermission(WebExtensionPermission::privacy()) || (incognito && !hasAccessToPrivateData()))
+            return;
+        sendToProcessesForEvent(type, Messages::WebExtensionContextProxy::DispatchPrivacySettingChangedEvent(String(key), payload));
+    });
+}
